{
  "name": "nightbeacon-server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "db:start": "node src/db/localDb.js start",
    "db:stop": "node src/db/localDb.js stop",
    "db:status": "node src/db/localDb.js status",
    "seed:source": "node src/db/seedSource.js",
    "seed:sources-bulk": "node src/db/seedSourcesBulk.js",
    "sources:backfill-ids": "node src/db/backfillChannelIds.js",
    "sources:list": "node src/db/listSources.js",
    "sources:official": "node src/db/officialFromFolder.js",
    "sources:discover": "node src/db/discoverSources.js",
    "sources:add": "node src/db/addCandidates.js",
    "sources:pattern": "node src/db/postingPattern.js",
    "seed:operator": "node src/db/seedOperator.js",
    "telegram:login": "node src/ingestion/generateSession.js",
    "telegram:check-proxy": "node src/ingestion/checkProxy.js",
    "ingest:check": "node src/ingestion/checkIngestion.js",
    "telegram:check-translate": "node src/processing/checkTelegramTranslate.js",
    "publish:check": "node src/publishing/checkPublishing.js",
    "translate:check": "node src/processing/checkTranslators.js",
    "translate:drain": "node src/processing/drainBacklog.js",
    "translate:skip-old": "node src/processing/skipOld.js",
    "publish:drain": "node src/publishing/drainDrafts.js",
    "publish:test-banner": "node src/publishing/testBanner.js",
    "stats:posts": "node src/publishing/postStats.js",
    "test": "node --import ./src/testSetup.mjs --test --test-concurrency=1 src/ingestion/*.test.js src/processing/*.test.js src/subsystems/*.test.js src/db/*.test.js src/dedup/*.test.js src/pipeline/*.test.js src/publishing/*.test.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^7.1.0",
    "input": "^1.0.1",
    "pg": "^8.13.1",
    "telegram": "^2.26.16",
    "zod": "^4.6.7"
  }
}
