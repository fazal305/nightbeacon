# Database
DATABASE_URL=postgres://nightbeacon:changeme@localhost:5432/nightbeacon

# Telegram (GramJS / MTProto user session — NEVER commit the real value)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Optional: proxy for reaching Telegram from a network where it's blocked.
# SOCKS4/5: set IP/PORT (+ optional SOCKS_TYPE, USERNAME, PASSWORD).
# MTProxy: set IP/PORT/SECRET instead.
TELEGRAM_PROXY_IP=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_SOCKS_TYPE=5
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_PROXY_SECRET=

# LLM translation provider — "groq" (default, generous free tier) or "openrouter"
LLM_PROVIDER=groq

# Groq (used when LLM_PROVIDER=groq) — free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (used when LLM_PROVIDER=openrouter) — free tier caps at 50 req/day
# without a $10 lifetime credit purchase; kept as a configurable fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# Server
PORT=4000
SESSION_SECRET=
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Single operator credentials (used only by the setup script to seed the users table)
OPERATOR_USERNAME=
OPERATOR_PASSWORD=
