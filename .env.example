# Database
DATABASE_URL=postgres://nightbeacon:changeme@localhost:5432/nightbeacon
# Only for a portable (non-service) PostgreSQL: lets `npm run db:start|db:stop|db:status`
# manage it. PG_BIN_DIR = folder containing pg_ctl; PG_DATA_DIR defaults to <repo>/.pgdata.
PG_BIN_DIR=
PG_DATA_DIR=

# Telegram (GramJS / MTProto user session — NEVER commit the real value)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Optional: proxy for reaching Telegram from a network where it's blocked.
# SOCKS4/5: set IP/PORT (+ optional SOCKS_TYPE, USERNAME, PASSWORD).
# MTProxy: set IP/PORT/SECRET instead. Plain (32 hex), "dd" and Fake-TLS "ee"
# secrets all work (hex or base64).
#
# Several proxies with automatic failover (recommended — public proxies come and go):
# paste t.me/proxy / tg://proxy / t.me/socks links, separated by commas or spaces,
# and/or point at a file with one link per line. Tried in order; after
# TELEGRAM_PROXY_FAILOVER_AFTER requests in a row get no answer, the next one is used.
# `npm run telegram:check-proxy` tests them all and prints this line fastest-first.
TELEGRAM_PROXY_LINKS=
TELEGRAM_PROXY_LINKS_FILE=
TELEGRAM_PROXY_FAILOVER_AFTER=3
TELEGRAM_CONNECT_TIMEOUT_MS=20000
TELEGRAM_REQUEST_TIMEOUT_MS=60000
TELEGRAM_PROXY_IP=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_SOCKS_TYPE=5
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_PROXY_SECRET=

# Ingestion pacing (see docs/PIPELINE.md). The global request rate is set by
# POLL_INTER_SOURCE_DELAY_MS; the intervals only decide which channel goes next.
POLL_INTER_SOURCE_DELAY_MS=750
POLL_MIN_INTERVAL_SECONDS=60
POLL_MAX_INTERVAL_SECONDS=600
TELEGRAM_RESOLVE_INTERVAL_MS=15000
# Persist posts pushed by Telegram for channels the account has joined.
TELEGRAM_LIVE_UPDATES=true

# Duplicate detection (runs before translation). Optional semantic matching
# uses a local Ollama server: `ollama pull bge-m3`, then EMBEDDING_PROVIDER=ollama.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=bge-m3
OLLAMA_URL=http://127.0.0.1:11434
DEDUP_FUZZY_THRESHOLD=0.75
DEDUP_SEMANTIC_THRESHOLD=0.9
DEDUP_SEMANTIC_CANDIDATE_THRESHOLD=0.82

# Processing: posts from the last N hours of Telegram time are processed before backlog.
PIPELINE_LIVE_WINDOW_HOURS=6
TRANSLATE_MAX_PER_MINUTE=50

# Translation provider(s). One, or an ordered list that is rotated: each post
# goes to the first available provider; one that is rate-limited, flood-waited
# or down is rested and the next takes over. Free options:
#   telegram        Telegram's own translateText via your session (no key)
#   google          Google Translate's free web endpoint (no key)
#   lingva          Lingva Translate public instances (LINGVA_URLS)
#   libretranslate  self-hosted LibreTranslate (LIBRETRANSLATE_URL), no limits
#   bing, yandex    free web endpoints (no key, unofficial)
#   microsoft       Microsoft Translator F0, ~2M chars/month (MS_TRANSLATOR_KEY, _REGION)
#   deepl           DeepL API Free, ~500k chars/month (DEEPL_API_KEY)
#   cloudflare      Workers AI m2m100 (CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN)
#   huggingface     NLLB on the free inference API (HF_TOKEN)
#   nllb            local NLLB-200 (tools/nllb/setup.ps1, NLLB_URL)
#   mymemory        tiny free allowance (MYMEMORY_EMAIL raises it)
#   gemini | cerebras | mistral | groq | openrouter | ollama   LLMs, 15 posts per call
#                   (share their allowance with drafting — put them last)
# Providers without their key are skipped (re-checked hourly).
# `npm run translate:check` shows which work from your network.
TRANSLATION_PROVIDER=telegram,google,bing,yandex,microsoft,deepl,lingva,cloudflare,nllb,libretranslate,huggingface,mymemory,cerebras,mistral,gemini
# Requests per minute for the web translators (one post per request).
GOOGLE_TRANSLATE_PER_MINUTE=60
LINGVA_TRANSLATE_PER_MINUTE=30
LINGVA_URLS=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Only for TRANSLATION_PROVIDER=telegram: translateText calls per minute (each up to 20 posts).
TELEGRAM_TRANSLATE_CALLS_PER_MINUTE=12

# LLM translation provider — "groq" (default, generous free tier) or "openrouter"
# (only used when TRANSLATION_PROVIDER=groq)
LLM_PROVIDER=groq

# Groq (used when LLM_PROVIDER=groq) — free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (used when LLM_PROVIDER=openrouter) — free tier caps at 50 req/day
# without a $10 lifetime credit purchase; kept as a configurable fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# Classification provider — "rule" (default, deterministic keyword matching,
# see classificationRules.js) or "jev" (TypeSafe AI's Jev model — see
# docs/adr/0005-jev-classification.md). Only relevant when CLASSIFICATION_PROVIDER=jev:
CLASSIFICATION_PROVIDER=rule
TYPESAFE_API_KEY=

# Server
PORT=4000
SESSION_SECRET=
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Single operator credentials (used only by the setup script to seed the users table)
OPERATOR_USERNAME=
OPERATOR_PASSWORD=

# Publishing to your channels (docs/PUBLISHING.md)
# off: only drafts you ask for; review: drafts important stories automatically,
# you approve; auto: bot-channel drafts at autoPriorities are posted automatically.
PUBLISH_MODE=off
# Your channels + posting prompts: server/publish-channels.json (copy the .example).
# With a single channel you can instead set PUBLISH_CHANNEL=@your_channel.
PUBLISH_CHANNEL=
# BotFather token; the bot must be admin (post messages) of your "bot" channel.
TELEGRAM_BOT_TOKEN=
PUBLISH_MIN_INTERVAL_SECONDS=35
PUBLISH_MAX_AGE_MINUTES=120
# Provider(s) for drafting, tried in order: groq | gemini | openrouter | ollama.
# "groq,gemini,openrouter": the next provider takes over when one is out of allowance.
DRAFT_LLM_PROVIDER=groq,gemini,openrouter
# Google Gemini — free key (no card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default: gemini-2.5-flash,gemini-2.0-flash (unknown ids are skipped)
GEMINI_MODEL=
# Drafting model(s). Groq's free daily limit is per model, so list several —
# when one runs out for the day the next is used. Empty = GROQ_MODEL.
DRAFT_LLM_MODEL=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3-32b,openai/gpt-oss-120b,llama-3.1-8b-instant
# Automatic drafts per channel per hour, each the best-scoring story (see
# docs/PUBLISHING.md). Per channel: "maxPerHour", "minGapMinutes", "settleMinutes".
PUBLISH_MAX_PER_HOUR=6
# Minutes a story waits before it can be picked (unless 3+ channels report it).
PUBLISH_SETTLE_MINUTES=3
# Photos/videos are posted with the text. Files larger than this are left out.
PUBLISH_MEDIA_MAX_MB=50
PUBLISH_MEDIA_TIMEOUT_SECONDS=180
# Time zone for scheduled summary times (channel option "digest").
PUBLISH_TIMEZONE=Asia/Karachi
# Big-event mode (channels with "surge" in channels.json post faster): on when
# high-priority stories in the last hour reach SURGE_RATIO x last week's hourly
# average (and at least SURGE_MIN_STORIES), or one story is reported by
# SURGE_STORY_REPORTS channels; stays on SURGE_HOLD_HOURS after the last burst.
SURGE_RATIO=3
SURGE_MIN_STORIES=12
SURGE_STORY_REPORTS=40
SURGE_HOLD_HOURS=2
DRAFT_MAX_PER_MINUTE=10
OLLAMA_MODEL=

# LLM translation batching (only for TRANSLATION_PROVIDER=groq): posts per call; 1 = off
LLM_TRANSLATE_BATCH=15

# Keys for optional translators / LLMs (see TRANSLATION_PROVIDER above)
MS_TRANSLATOR_KEY=
MS_TRANSLATOR_REGION=
DEEPL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
HF_TOKEN=
MYMEMORY_EMAIL=
NLLB_URL=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
